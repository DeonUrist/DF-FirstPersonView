# Fortification: a block on each corner of the low sill (the sill is 0.225 high and not
# part of this model). Lined up, the blocks of neighbours join into the teeth of a
# battlement, whichever way the wall runs.
# (how a model is laid out: README.txt)
mtllib models.mtl
o Fortification
v -0.500000 0.225000 -0.500000
v -0.230000 0.225000 -0.500000
v -0.230000 0.225000 -0.230000
v -0.500000 0.225000 -0.230000
v -0.500000 0.500000 -0.500000
v -0.230000 0.500000 -0.500000
v -0.230000 0.500000 -0.230000
v -0.500000 0.500000 -0.230000
usemtl own
f 1 2 3 4
f 8 7 6 5
f 5 6 2 1
f 6 7 3 2
f 7 8 4 3
f 8 5 1 4
o Fortification.001
v 0.230000 0.225000 -0.500000
v 0.500000 0.225000 -0.500000
v 0.500000 0.225000 -0.230000
v 0.230000 0.225000 -0.230000
v 0.230000 0.500000 -0.500000
v 0.500000 0.500000 -0.500000
v 0.500000 0.500000 -0.230000
v 0.230000 0.500000 -0.230000
usemtl own
f 9 10 11 12
f 16 15 14 13
f 13 14 10 9
f 14 15 11 10
f 15 16 12 11
f 16 13 9 12
