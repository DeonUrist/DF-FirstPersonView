# Bookcase: a block with the game's picture of it (shelves of books) on its front.
# Made with its back to the north wall; turned to its own wall in the game.
# (how a model is laid out: README.txt)
mtllib models.mtl
o Bookcase [when=wall]
v -0.400000 0.000000 -0.460000
v 0.400000 0.000000 -0.460000
v 0.400000 0.000000 0.000000
v -0.400000 0.000000 0.000000
v -0.400000 0.820000 -0.460000
v 0.400000 0.820000 -0.460000
v 0.400000 0.820000 0.000000
v -0.400000 0.820000 0.000000
usemtl own
f 1 2 3 4
f 8 7 6 5
f 5 6 2 1
f 6 7 3 2
f 8 5 1 4
usemtl picture
f 7 8 4 3
o Bookcase.001 [when=free]
v -0.400000 0.000000 -0.230000
v 0.400000 0.000000 -0.230000
v 0.400000 0.000000 0.230000
v -0.400000 0.000000 0.230000
v -0.400000 0.820000 -0.230000
v 0.400000 0.820000 -0.230000
v 0.400000 0.820000 0.230000
v -0.400000 0.820000 0.230000
usemtl own
f 9 10 11 12
f 16 15 14 13
f 13 14 10 9
f 14 15 11 10
f 16 13 9 12
usemtl picture
f 15 16 12 11
