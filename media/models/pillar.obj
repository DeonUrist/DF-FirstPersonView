# Support: a pillar from floor to ceiling (one level is 1.2 high).
# (how a model is laid out: README.txt)
mtllib models.mtl
o Pillar
v -0.180000 0.000000 -0.180000
v 0.180000 0.000000 -0.180000
v 0.180000 0.000000 0.180000
v -0.180000 0.000000 0.180000
v -0.180000 1.200000 -0.180000
v 0.180000 1.200000 -0.180000
v 0.180000 1.200000 0.180000
v -0.180000 1.200000 0.180000
usemtl own
f 1 2 3 4
f 8 7 6 5
f 5 6 2 1
f 6 7 3 2
f 7 8 4 3
f 8 5 1 4
